      "webhookId": "3f1978c8-4592-4a4f-aa0f-cea5619ee8fe"
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "prompt": "=You are an expert Customer Support AI Assistant.\nAnalyze the following support ticket and classify it accurately.\n\nCustomer Name: {{ $json.body.customer_name }}\nSubject: {{ $json.body.subject }}\nIssue Description: {{ $json.body.message }}\n\nPerform the following tasks:\n1. Categorize into: \"Billing\", \"Technical\", \"Account\", or \"General\".\n2. Set Urgency: \"High\", \"Medium\", or \"Low\".\n3. Set requires_human: true (if refund, sensitive credential issue, or system bug), else false.\n4. Draft an empathetic, polite, and helpful auto-reply in Urdu/English blend.\n\nReturn strictly JSON format:\n{\n  \"category\": \"<Category>\",\n  \"urgency\": \"<High|Medium|Low>\",\n  \"requires_human\": <true|false>,\n  \"ai_response\": \"<Drafted reply text>\"\n}",
        "options": {},
        "requestOptions": {}
      },
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        -96,
        160
      ],
      "id": "3dc5da65-325a-42f4-892a-c2a30726f829",
      "name": "Support AI Agent",
      "credentials": {
        "openAiApi": {
          "id": "AsvuYb9isrZy6jRb",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Input data aur Webhook data ko safely retrieve karna\nconst inputJson = $input.first()?.json || {};\nlet webhookData = {};\n\ntry {\n  webhookData = $(\"Incoming Ticket Webhook\").first()?.json?.body || $(\"Incoming Ticket Webhook\").first()?.json || {};\n} catch (e) {\n  webhookData = {};\n}\n\n// OpenAI ya AI Agent node se raw output nikalna\nlet aiRaw = inputJson.output || inputJson.text || inputJson.message?.content || inputJson.response || \"\";\n\nlet parsed = {};\n\nif (typeof aiRaw === 'object' && aiRaw !== null) {\n  parsed = aiRaw;\n} else if (typeof aiRaw === 'string') {\n  // Clean markdown ```json ``` tags if present\n  const cleanJson = aiRaw.replace(/```json/gi, '').replace(/```/g, '').trim();\n  try {\n    parsed = JSON.parse(cleanJson);\n  } catch (e) {\n    parsed = {\n      category: \"General\",\n      urgency: \"Medium\",\n      requires_human: true,\n      ai_response: aiRaw || \"Thank you for reaching out.\"\n    };\n  }\n}\n\nreturn {\n  json: {\n    ticket_id: webhookData.ticket_id || \"TCK-1001\",\n    customer_name: webhookData.customer_name || \"Wajiha Fareed\",\n    customer_email: webhookData.customer_email || \"wajihafareed00@gmail.com\",\n    subject: webhookData.subject || \"Payment Deducted But Account Inactive\",\n    original_message: webhookData.message || \"My payment of $50 was deducted yesterday, but my subscription is still inactive. Please check this issue and activate my account.\",\n    category: parsed.category || \"General\",\n    urgency: parsed.urgency || \"Medium\",\n    requires_human: Boolean(parsed.requires_human),\n    ai_response: parsed.ai_response || \"Assalam-o-Alaikum! We have received your query and will get back to you shortly.\",\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        160
      ],
      "id": "4479635c-fdb8-47f8-a3e1-e4eba70c198d",
      "name": "Parse AI Output"
